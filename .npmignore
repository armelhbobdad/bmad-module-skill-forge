# Git
.git
.gitignore
.github

# Documentation (root-level .md files except README)
/*.md
!/README.md

# Website and build output
website/
build/

# BMAD framework and IDE config (not part of the module)
_bmad/
_bmad-output/
.claude/
.cursor/

# Maintainer session memory (IWE store) — not part of the module
memory/
.iwe/

# Development tools and config
test/
*.test.js
eslint.config.mjs
prettier.config.mjs
.markdownlint-cli2.yaml
.prettierignore
.eslintrc.*
.prettierrc.*
.husky/
.npmrc

# Quality reports and build output
skills/

# Python bytecode
__pycache__/
*.pyc

# Maintainer tools. Every script directly under tools/ is one (validators,
# docs build, release notes), except the npx wrapper that package.json's bin
# points at. The pattern matches only that level: the installer CLI in
# tools/cli/ still ships.
tools/*.js
!tools/skf-npx-wrapper.js

# Change fragments: rendered into CHANGELOG.md and the GitHub Release at
# release time, not read at runtime.
changes/

# Maintainer-only release material. STABILITY.md is deliberately NOT excluded:
# it is the public API contract a consumer pinning ^2.0.0 may want to read from
# the installed package.
release-audits/
docs/_internal/RELEASING.md

# Output and temp
temp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Misc
*.log
.env
.env.*
