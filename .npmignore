# Git
.git
.gitignore
.github

# Documentation (root-level .md files except README)
/*.md
!/README.md

# Website and build output
website/
build/

# BMAD framework and IDE config (not part of the module)
_bmad/
_bmad-output/
.claude/
.cursor/

# Maintainer session memory (IWE store) — not part of the module
memory/
.iwe/

# Development tools and config
test/
tools/build-docs.js
tools/fix-doc-links.js
tools/validate-doc-links.js
*.test.js
eslint.config.mjs
prettier.config.mjs
.markdownlint-cli2.yaml
.prettierignore
.eslintrc.*
.prettierrc.*
.husky/
.npmrc

# Quality reports and build output
skills/

# Python bytecode
__pycache__/
*.pyc

# Dev-only validation tools (not needed at runtime).
# NOTE: validate-doc-links.js (singular) and validate-docs-links.js (plural)
# are two different files that both exist — name both, or the plural one ships.
tools/validate-skills.js
tools/validate-file-refs.js
tools/validate-docs-links.js
tools/validate-docs-drift.js

# Maintainer-only release material. STABILITY.md is deliberately NOT excluded:
# it is the public API contract a consumer pinning ^2.0.0 may want to read from
# the installed package.
release-audits/
docs/_internal/RELEASING.md

# Output and temp
temp/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Node
node_modules/

# Misc
*.log
.env
.env.*
